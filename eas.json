{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://192.168.3.117:5000/api",
        "EXPO_PUBLIC_CRM_BACKEND_URL": "https://crm.pydah.edu.in",
        "EXPO_PUBLIC_GATEWAY_URL": "http://192.168.3.117:5000/api/v1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://sdms.pydah.edu.in/api",
        "EXPO_PUBLIC_CRM_BACKEND_URL": "https://crm.pydah.edu.in",
        "EXPO_PUBLIC_GATEWAY_URL": "https://sdms.pydah.edu.in/api/v1"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://sdms.pydah.edu.in/api",
        "EXPO_PUBLIC_CRM_BACKEND_URL": "https://crm.pydah.edu.in",
        "EXPO_PUBLIC_GATEWAY_URL": "https://sdms.pydah.edu.in/api/v1"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://sdms.pydah.edu.in/api",
        "EXPO_PUBLIC_CRM_BACKEND_URL": "https://crm.pydah.edu.in",
        "EXPO_PUBLIC_GATEWAY_URL": "https://sdms.pydah.edu.in/api/v1"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
