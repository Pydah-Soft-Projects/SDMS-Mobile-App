{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:5000/api",
        "EXPO_PUBLIC_CRM_BACKEND_URL": "https://crm.pydah.edu.in",
        "EXPO_PUBLIC_GATEWAY_URL": "http://10.0.2.2:5000/api/v1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://staging-api.pydah.edu.in/api",
        "EXPO_PUBLIC_CRM_BACKEND_URL": "https://crm.pydah.edu.in",
        "EXPO_PUBLIC_GATEWAY_URL": "https://staging-api.pydah.edu.in/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.pydah.edu.in/api",
        "EXPO_PUBLIC_CRM_BACKEND_URL": "https://crm.pydah.edu.in",
        "EXPO_PUBLIC_GATEWAY_URL": "https://api.pydah.edu.in/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

