# Pydah Student Portal - Mobile Environment Variables
# For Expo, environment variables exposed to the client must start with EXPO_PUBLIC_

# Environment Mode: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Backend Base API URL (e.g., http://localhost:5000/api or http://10.0.2.2:5000/api for Android Emulator)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# CRM & SSO Backend URL
EXPO_PUBLIC_CRM_BACKEND_URL=https://crm.pydah.edu.in

# Pydah Payment Gateway Base URL
EXPO_PUBLIC_GATEWAY_URL=http://localhost:5000/api/v1

